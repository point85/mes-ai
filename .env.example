# MES AI — Docker Compose Configuration
# Copy this file to .env and adjust values before running the installer.
# Lines starting with # are comments and are ignored.

# ── Image version ─────────────────────────────────────────────────────────────
# "local" = build from source (default for first-time install).
# Set to a published tag (e.g. 1.0.0) to pull pre-built images from the registry.
MES_IMAGE_TAG=local

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mes_ai_s95

# ── Exposed ports ─────────────────────────────────────────────────────────────
# Change these if any port conflicts with existing services on your machine.
PORT_SERVER=8082
PORT_DT=5173
PORT_RT=5176
PORT_ERP_SIM=5174
PORT_EQUIP_SIM=5175

# ── MES Server ────────────────────────────────────────────────────────────────
# none  = no authentication (evaluation / development)
# local = built-in username/password authentication
# oidc  = external OpenID Connect identity provider
MES_AUTH_MODE=none

# IMPORTANT: replace with a random 32-byte string before any production use.
# The installer generates one automatically on first run.
MES_SECRET_KEY=change-me-to-a-random-32-byte-string

# Log verbosity: DEBUG | INFO | WARNING | ERROR
MES_LOG_LEVEL=INFO

# Event bus: memory (single-server default) | redis (distributed, requires Redis)
MES_EVENT_BUS_TYPE=memory

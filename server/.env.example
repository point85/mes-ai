# MES AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# All variables are prefixed with MES_ (see config.py).

# --- Database ---
MES_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mes_ai_s95
MES_DB_ECHO=false
MES_DB_POOL_SIZE=20
MES_DB_MAX_OVERFLOW=10

# --- Authentication ---
# "local" for development, "oidc" for production with external IdP
MES_AUTH_MODE=local
MES_SECRET_KEY=change-me-to-a-random-32-byte-string
MES_ALGORITHM=HS256
MES_ACCESS_TOKEN_EXPIRE_MINUTES=15
MES_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OIDC (when AUTH_MODE=oidc) ---
# MES_OIDC_ISSUER=https://your-idp.example.com
# MES_OIDC_CLIENT_ID=mes-ai
# MES_OIDC_CLIENT_SECRET=your-client-secret
# MES_OIDC_SCOPES=openid,profile,email
# MES_OIDC_ROLE_CLAIM=groups
# MES_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# --- Event Bus ---
# "memory" for single-server, "redis" for distributed
MES_EVENT_BUS_TYPE=memory
# MES_REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# MES AI Windows Service Configuration
# Copy this file to mes-service.conf and edit the values for your environment.
# Lines beginning with # are comments and are ignored.
# ---------------------------------------------------------------------------

# ── Service identity ────────────────────────────────────────────────────────
ServiceName        = MesAI
ServiceDisplayName = MES AI Server
ServiceDescription = MES AI Manufacturing Execution System Server

# ── Database connection ─────────────────────────────────────────────────────
# Database engine: PostgreSQL | MSSQL | Oracle
Database           = PostgreSQL

# Database name
DbName             = mes_ai

# Database host, or host:port.  Defaults to localhost with the engine's
# standard port when only a host name is given.
DbServer           = localhost

# Database credentials
Username           = postgres
Password           = postgres

# ── Server settings ─────────────────────────────────────────────────────────
# Port uvicorn listens on
UvicornPort        = 8082

# Number of uvicorn worker processes (recommended: (2 × CPU cores) + 1)
Workers            = 4

# Authentication mode: none | oidc
AuthMode           = none

# ── Logging ─────────────────────────────────────────────────────────────────
# Directory for service stdout / stderr logs.
# Leave blank to use <project>\server\logs
LogDir             =

# ── Service startup ─────────────────────────────────────────────────────────
# Windows service start type: auto | delayed-auto | manual | disabled
StartType          = auto
